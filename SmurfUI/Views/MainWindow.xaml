<Window x:Class="SmurfUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⭐ SCHTROUMPF — La Quête des Salsepareilles Dorées"
        Height="960" Width="1360"
        MinHeight="760" MinWidth="1080"
        WindowStartupLocation="CenterScreen">
    <!--
        Les converters ImageConverter et HealthToColorConverter sont déclarés
        dans App.xaml et disponibles via StaticResource dans toute l'app.
        Aucune Window.Resources locale nécessaire.
    -->

    <!-- ═══════════════════════════════════
         WINDOW BACKGROUND
    ═══════════════════════════════════ -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#020c08" Offset="0"/>
            <GradientStop Color="#041508" Offset="0.55"/>
            <GradientStop Color="#020b0d" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <!-- ROOT GRID: atmospheric layers + main content + overlay -->
    <Grid>

        <!-- ═══════════════════════════════════
             ATMOSPHERIC BACKGROUND GLOWS
             Three large radial ellipses create
             a bioluminescent forest ambiance.
             IsHitTestVisible=False so they
             never block clicks.
        ═══════════════════════════════════ -->
        <Grid IsHitTestVisible="False">

            <!-- Top-left emerald bloom -->
            <Ellipse Width="680" Height="680"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-260,-260,0,0" Opacity="0.07">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#00ff88" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Right-center sapphire bloom -->
            <Ellipse Width="560" Height="560"
                     HorizontalAlignment="Right" VerticalAlignment="Center"
                     Margin="0,0,-180,0" Opacity="0.055">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#0066ff" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Bottom-center gold bloom (sarsaparilla aura) -->
            <Ellipse Width="1000" Height="420"
                     HorizontalAlignment="Center" VerticalAlignment="Bottom"
                     Margin="0,0,0,-340" Opacity="0.04">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#ffd700" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

        </Grid>


        <!-- ═══════════════════════════════════
             MAIN CONTENT  (2-column layout)
        ═══════════════════════════════════ -->
        <Grid Margin="14,10,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="296"/>
                <!-- LEFT: Stats + Controls -->
                <ColumnDefinition Width="14"/>
                <!-- DIVIDER -->
                <ColumnDefinition Width="*"/>
                <!-- RIGHT: Game Grid -->
            </Grid.ColumnDefinitions>


            <!-- ╔═══════════════════════════════╗
                 ║         LEFT PANEL            ║
                 ╚═══════════════════════════════╝ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- R0: Title -->
                    <RowDefinition Height="Auto"/>
                    <!-- R1: Health -->
                    <RowDefinition Height="Auto"/>
                    <!-- R2: Stars + Enemies -->
                    <RowDefinition Height="Auto"/>
                    <!-- R3: Position / Objective -->
                    <RowDefinition Height="*"/>
                    <!-- R4: Journal log -->
                    <RowDefinition Height="Auto"/>
                    <!-- R5: D-Pad -->
                    <RowDefinition Height="Auto"/>
                    <!-- R6: Action buttons -->
                </Grid.RowDefinitions>


                <!-- ── R0: TITLE BLOCK ── -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14">

                    <!-- Top decorative rule -->
                    <Grid Height="18" Margin="0,0,0,6">
                        <Rectangle Height="1" VerticalAlignment="Center">
                            <Rectangle.Fill>
                                <LinearGradientBrush>
                                    <GradientStop Color="Transparent"  Offset="0"/>
                                    <GradientStop Color="#244030"      Offset="0.35"/>
                                    <GradientStop Color="#f0c040"      Offset="0.5"/>
                                    <GradientStop Color="#244030"      Offset="0.65"/>
                                    <GradientStop Color="Transparent"  Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <TextBlock Text="✦  ✦  ✦" Foreground="#f0c040" FontSize="9"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Opacity="0.65"/>
                    </Grid>

                    <!-- Game title -->
                    <TextBlock Text="SCHTROUMPF"
                               FontFamily="Palatino Linotype, Times New Roman"
                               FontSize="27" FontWeight="Bold"
                               Foreground="#f0c040"
                               TextAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#f0c040" BlurRadius="20"
                                              ShadowDepth="0" Opacity="0.80"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Subtitle -->
                    <TextBlock Text="La Quête des Salsepareilles Dorées"
                               FontFamily="Palatino Linotype, Georgia"
                               FontSize="10" Foreground="#5a8a5a"
                               FontStyle="Italic"
                               TextAlignment="Center" Margin="0,3,0,0"/>

                    <!-- Bottom decorative rule -->
                    <Rectangle Height="1" Margin="18,8,18,0">
                        <Rectangle.Fill>
                            <LinearGradientBrush>
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#1a3d22"    Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                </StackPanel>


                <!-- ── R1: HEALTH CARD ── -->
                <Border Grid.Row="1" Style="{StaticResource StatCard}">
                    <StackPanel>

                        <!-- Label + current value -->
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="❤ SANTÉ" FontSize="9.5"
                                       Foreground="#6a9a6a" FontFamily="Consolas"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        DockPanel.Dock="Right">
                                <TextBlock Text="{Binding SmurfHealth}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#4cdb70" FontFamily="Consolas"
                                           VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#00ff60" BlurRadius="7"
                                                          ShadowDepth="0" Opacity="0.55"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text=" / 500" FontSize="11"
                                           Foreground="#2e5030" FontFamily="Consolas"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Custom health bar -->
                        <ProgressBar Maximum="500"
                                     Value="{Binding SmurfHealth}"
                                     Height="17"
                                     Style="{StaticResource HealthBarStyle}"
                                     Foreground="{Binding SmurfHealth,
                                         Converter={StaticResource HealthToColorConverter}}"/>

                    </StackPanel>
                </Border>


                <!-- ── R2: STARS + ENEMIES (side by side) ── -->
                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- SARSAPARILLES card -->
                    <Border Grid.Column="0" CornerRadius="12" BorderThickness="1"
                            Padding="10,9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#181000" Offset="0"/>
                                <GradientStop Color="#0c0a00" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4a3a00" Offset="0"/>
                                <GradientStop Color="#262000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <StackPanel>
                            <TextBlock Text="SALSEPAREILLES" FontSize="7.5"
                                       Foreground="#8a7840" FontFamily="Consolas"
                                       FontWeight="Bold" TextAlignment="Center"/>
                            <TextBlock FontSize="30" FontWeight="Bold"
                                       FontFamily="Consolas"
                                       TextAlignment="Center" Margin="0,2,0,1">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#f0c040" BlurRadius="18"
                                                      ShadowDepth="0" Opacity="0.95"/>
                                </TextBlock.Effect>
                                <Run Text="{Binding GoldenSarsaparillasCollected}"
                                     Foreground="#f0c040"/>
                                <Run Text=" /3" Foreground="#403010" FontSize="13"/>
                            </TextBlock>
                            <!-- 3 star pip row -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="⭐" FontSize="13"
                                           FontFamily="Segoe UI Emoji" Margin="1,0"/>
                                <TextBlock Text="⭐" FontSize="13"
                                           FontFamily="Segoe UI Emoji" Margin="1,0"/>
                                <TextBlock Text="⭐" FontSize="13"
                                           FontFamily="Segoe UI Emoji" Margin="1,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ENEMIES card -->
                    <Border Grid.Column="2" CornerRadius="12" BorderThickness="1"
                            Padding="10,9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#180600" Offset="0"/>
                                <GradientStop Color="#0c0300" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#5a2800" Offset="0"/>
                                <GradientStop Color="#2a1200" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <StackPanel>
                            <TextBlock Text="ENNEMIS VAINCUS" FontSize="7.5"
                                       Foreground="#8a5040" FontFamily="Consolas"
                                       FontWeight="Bold" TextAlignment="Center"/>
                            <TextBlock FontSize="30" FontWeight="Bold"
                                       FontFamily="Consolas"
                                       TextAlignment="Center" Margin="0,2,0,1">
                                <Run Text="{Binding EnemiesDefeated}" Foreground="#ff6b6b"/>
                            </TextBlock>
                            <TextBlock Text="🗡 tués" FontSize="12"
                                       Foreground="#5a2020" TextAlignment="Center"
                                       FontFamily="Segoe UI Emoji"/>
                        </StackPanel>
                    </Border>

                </Grid>


                <!-- ── R3: POSITION + OBJECTIVE ── -->
                <Border Grid.Row="3" Style="{StaticResource StatCard}" Padding="14,9">
                    <DockPanel>
                        <!-- Position (left side) -->
                        <StackPanel>
                            <TextBlock Text="📍 POSITION" FontSize="8.5"
                                       Foreground="#4a7a52" FontFamily="Consolas"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding SmurfPosition}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="#00d4ff" FontFamily="Consolas"
                                       Margin="0,2,0,0">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#00d4ff" BlurRadius="10"
                                                      ShadowDepth="0" Opacity="0.65"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                        <!-- Objective (right side) -->
                        <StackPanel HorizontalAlignment="Right" DockPanel.Dock="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Text="🎯 OBJECTIF" FontSize="8.5"
                                       Foreground="#4a7a52" FontFamily="Consolas"
                                       FontWeight="Bold" TextAlignment="Right"/>
                            <TextBlock Text="3 ⭐  +  retour" FontSize="12"
                                       FontWeight="Bold" Foreground="#f0c040"
                                       FontFamily="Consolas" TextAlignment="Right"
                                       Margin="0,2,0,0"/>
                            <TextBlock Text="à (0, 0)" FontSize="10"
                                       Foreground="#907020" FontFamily="Consolas"
                                       TextAlignment="Right"/>
                        </StackPanel>
                    </DockPanel>
                </Border>


                <!-- ── R4: JOURNAL LOG ── -->
                <Border Grid.Row="4" CornerRadius="12" BorderThickness="1"
                        Padding="12,10" Margin="0,0,0,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#020905" Offset="0"/>
                            <GradientStop Color="#020703" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#133020" Offset="0"/>
                            <GradientStop Color="#0a1a10" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Log header -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,7">
                            <TextBlock Text="📜" FontSize="11"
                                       FontFamily="Segoe UI Emoji"
                                       VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="JOURNAL DE BORD" FontSize="8.5"
                                       Foreground="#3a6a3a" FontFamily="Consolas"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- Log text -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Text="{Binding LastActionMessage}"
                                       Foreground="#80b880" TextWrapping="Wrap"
                                       FontSize="11.5" FontFamily="Consolas"
                                       LineHeight="18"/>
                        </ScrollViewer>
                    </Grid>
                </Border>


                <!-- ── R5: D-PAD ── -->
                <StackPanel Grid.Row="5" HorizontalAlignment="Center"
                            Margin="0,0,0,10">

                    <!-- Keyboard hint -->
                    <TextBlock Text="Z Q S D  ·  ← ↑ → ↓" FontSize="8.5"
                               Foreground="#1e3a1e" TextAlignment="Center"
                               FontFamily="Consolas" Margin="0,0,0,6"/>

                    <!-- Separating label -->
                    <TextBlock Text="—  DÉPLACEMENT  —" FontSize="8.5"
                               Foreground="#254525" TextAlignment="Center"
                               FontFamily="Consolas" Margin="0,0,0,8"/>

                    <!-- D-Pad 3×3 grid -->
                    <Grid Width="192" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- UP -->
                        <Button Grid.Row="0" Grid.Column="1"
                                Content="▲"
                                Command="{Binding MoveUpCommand}"
                                Style="{StaticResource DPadButton}"
                                Margin="3"/>

                        <!-- LEFT -->
                        <Button Grid.Row="1" Grid.Column="0"
                                Content="◀"
                                Command="{Binding MoveLeftCommand}"
                                Style="{StaticResource DPadButton}"
                                Margin="3"/>

                        <!-- CENTER (decorative hub) -->
                        <Border Grid.Row="1" Grid.Column="1"
                                CornerRadius="9" Margin="3">
                            <Border.Background>
                                <RadialGradientBrush>
                                    <GradientStop Color="#0f1e14" Offset="0"/>
                                    <GradientStop Color="#060e09" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush>
                                    <GradientStop Color="#1a3e24" Offset="0"/>
                                    <GradientStop Color="#0d1e12" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.BorderThickness>1</Border.BorderThickness>
                            <TextBlock Text="✦" Foreground="#1c4226"
                                       FontSize="22" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- RIGHT -->
                        <Button Grid.Row="1" Grid.Column="2"
                                Content="▶"
                                Command="{Binding MoveRightCommand}"
                                Style="{StaticResource DPadButton}"
                                Margin="3"/>

                        <!-- DOWN -->
                        <Button Grid.Row="2" Grid.Column="1"
                                Content="▼"
                                Command="{Binding MoveDownCommand}"
                                Style="{StaticResource DPadButton}"
                                Margin="3"/>

                    </Grid>
                </StackPanel>


                <!-- ── R6: ACTION BUTTONS ── -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="🔄  NOUVELLE"
                            Height="44"
                            Command="{Binding NewGameCommand}"
                            Style="{StaticResource NewGameActionButton}"/>
                    <Button Grid.Column="2"
                            Content="💾  SAUVEGARDER"
                            Height="44"
                            Command="{Binding SaveGameCommand}"
                            Style="{StaticResource SaveActionButton}"/>
                    <Button Grid.Column="4"
                            Content="📂  CHARGER"
                            Height="44"
                            Command="{Binding LoadGameCommand}"
                            Style="{StaticResource SaveActionButton}"/>
                </Grid>

            </Grid>
            <!-- END LEFT PANEL -->


            <!-- ╔═══════════════════════════════╗
                 ║      VERTICAL DIVIDER         ║
                 ╚═══════════════════════════════╝ -->
            <Border Grid.Column="1" Width="1" Margin="0,24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#163022"    Offset="0.12"/>
                        <GradientStop Color="#264e32"    Offset="0.5"/>
                        <GradientStop Color="#163022"    Offset="0.88"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>


            <!-- ╔═══════════════════════════════╗
                 ║         RIGHT PANEL           ║
                 ║      (Game Grid area)         ║
                 ╚═══════════════════════════════╝ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header + legend -->
                    <RowDefinition Height="*"/>
                    <!-- Grid itself -->
                </Grid.RowDefinitions>


                <!-- ── Grid header + legend ── -->
                <Grid Grid.Row="0" Margin="0,0,0,8">

                    <!-- Forest name (left) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="❧" FontSize="20" Foreground="#285038"
                                   FontFamily="Palatino Linotype"
                                   VerticalAlignment="Center" Margin="0,0,8,2"/>
                        <TextBlock Text="FORÊT DES MURMURES"
                                   FontFamily="Palatino Linotype, Georgia"
                                   FontSize="17" FontWeight="Bold"
                                   Foreground="#2a6040" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#00ff60" BlurRadius="10"
                                                  ShadowDepth="0" Opacity="0.25"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>

                    <!-- Legend pills (right) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Border Background="#0a1810" CornerRadius="6"
                                Padding="7,3" Margin="3,0">
                            <TextBlock Text="🔵 Héros" FontSize="10" Foreground="#5090b0"
                                       FontFamily="Segoe UI Emoji"/>
                        </Border>
                        <Border Background="#0a1810" CornerRadius="6"
                                Padding="7,3" Margin="3,0">
                            <TextBlock Text="🕷 Araignée" FontSize="10" Foreground="#8060a0"
                                       FontFamily="Segoe UI Emoji"/>
                        </Border>
                        <Border Background="#0a1810" CornerRadius="6"
                                Padding="7,3" Margin="3,0">
                            <TextBlock Text="🪰 Bzz Fly" FontSize="10" Foreground="#888828"
                                       FontFamily="Segoe UI Emoji"/>
                        </Border>
                        <Border Background="#0a1810" CornerRadius="6"
                                Padding="7,3" Margin="3,0">
                            <TextBlock Text="⭐ Salsep." FontSize="10" Foreground="#b09020"
                                       FontFamily="Segoe UI Emoji"/>
                        </Border>
                        <Border Background="#0a1810" CornerRadius="6"
                                Padding="7,3" Margin="3,0">
                            <TextBlock Text="🍓 Baie" FontSize="10" Foreground="#c04060"
                                       FontFamily="Segoe UI Emoji"/>
                        </Border>
                    </StackPanel>

                </Grid>


                <!-- ── THE GAME GRID ── -->
                <Border Grid.Row="1" CornerRadius="14" BorderThickness="1"
                        Padding="3" Background="#010602">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1e4a28" Offset="0"/>
                            <GradientStop Color="#0d2018" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect Color="#00ff60" BlurRadius="22"
                                          ShadowDepth="0" Opacity="0.07"/>
                    </Border.Effect>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding GridCells}">

                            <!-- 21 × 21 uniform grid -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="21" Columns="21"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <!-- Each cell template -->
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!--
                                        Cell is 48×48.
                                        Layer 1 (bottom) : forest.png always fills the tile → gives the
                                                           forest-floor texture on every square.
                                        Layer 2 (top)    : creature / item sprite at 42×42, shown only
                                                           when ImageName is NOT "forest" / "".
                                        No emoji fallback needed: forest tiles are covered by layer 1.
                                    -->
                                    <Border Width="48" Height="48"
                                            BorderBrush="#0a1a0e" BorderThickness="0.5"
                                            Background="#040d06">
                                        <Grid>

                                            <!-- ── LAYER 1: Forest background tile ──
                                                 Stretches to fill the whole cell.
                                                 Falls back to the dark Border.Background
                                                 if forest.png is missing.              -->
                                            <Image Source="pack://application:,,,/Assets/Images/forest.png"
                                                   Stretch="UniformToFill"
                                                   Width="120" Height="120"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                                            <!-- ── LAYER 2: Entity sprite ──
                                                 Larger than before (42×42) so creatures
                                                 really pop over the forest texture.
                                                 Hidden for pure-forest cells.          -->
                                            <Image Source="{Binding ImageName,
                                                       Converter={StaticResource ImageConverter}}"
                                                   Width="80" Height="80"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ImageName}" Value="forest">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ImageName}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>
                    </ScrollViewer>
                </Border>

            </Grid>
            <!-- END RIGHT PANEL -->

        </Grid>
        <!-- END MAIN CONTENT -->


        <!-- ═══════════════════════════════════
             GAME OVER / VICTORY OVERLAY
             Appears on top of everything when
             GameOverlayVisibility = Visible.
        ═══════════════════════════════════ -->
        <Border Background="#D8000000"
                Visibility="{Binding GameOverlayVisibility}">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <Border CornerRadius="22" BorderThickness="2"
                        Padding="44,34" MaxWidth="540">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#070f0b" Offset="0"/>
                            <GradientStop Color="#0c1a14" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush>
                            <GradientStop Color="#f0c040" Offset="0"/>
                            <GradientStop Color="#906010" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect Color="#f0c040" BlurRadius="45"
                                          ShadowDepth="0" Opacity="0.65"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Message text (set by ViewModel) -->
                        <TextBlock Text="{Binding GameOverlayMessage}"
                                   FontSize="19" FontWeight="Bold"
                                   Foreground="White"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontFamily="Palatino Linotype, Georgia"
                                   LineHeight="26"
                                   Margin="0,0,0,26"/>

                        <!-- Restart button -->
                        <Button Content="🔄  NOUVELLE PARTIE"
                                Command="{Binding NewGameCommand}"
                                Height="56" Width="280"
                                FontSize="16" FontWeight="Bold"
                                HorizontalAlignment="Center"
