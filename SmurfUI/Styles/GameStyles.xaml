<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         ENCHANTED FOREST — Design System
         Palette:
           Background  #020c08 → #041408
           Surface     #0a1810 → #060f09
           Border      #1e4a2a → #0d2015
           Gold        #f0c040  (sarsaparilla, title)
           Cyan        #00d4ff  (position, highlights)
           GreenGlow   #00ff88  (atmospheric, health)
           DangerRed   #ff6b6b  (enemies)
    ============================================================ -->


    <!-- ═══════════════════════════════
         STAT CARD  (Border base style)
    ═══════════════════════════════ -->
    <Style x:Key="StatCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,11"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0a1810" Offset="0"/>
                    <GradientStop Color="#060f09" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1e4a2a" Offset="0"/>
                    <GradientStop Color="#0d2015" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ═══════════════════════════════
         HEALTH BAR  (custom ProgressBar)
    ═══════════════════════════════ -->
    <Style x:Key="HealthBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="17"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <!-- Outer container with border and clipping -->
                    <Border Background="#050c07" CornerRadius="8"
                            BorderBrush="#183525" BorderThickness="1"
                            ClipToBounds="True">
                        <Grid>
                            <!-- PART_Track: transparent reference element -->
                            <Rectangle x:Name="PART_Track" Opacity="0"/>

                            <!-- PART_Indicator: the filled bar, colored by Foreground binding -->
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left" Margin="0"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="7"/>

                            <!-- Shine overlay (top highlight) -->
                            <Border IsHitTestVisible="False" CornerRadius="7"
                                    VerticalAlignment="Top" Height="7" Margin="1,1,1,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#28ffffff" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Inner shadow at bottom -->
                            <Border IsHitTestVisible="False" CornerRadius="7"
                                    VerticalAlignment="Bottom" Height="5" Margin="1,0,1,1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="#18000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ═══════════════════════════════
         D-PAD BUTTON
    ═══════════════════════════════ -->
    <Style x:Key="DPadButton" TargetType="Button">
        <Setter Property="Width" Value="54"/>
        <Setter Property="Height" Value="54"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#6aaa7a"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="outerBorder" CornerRadius="10"
                            BorderBrush="#1a3e24" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0e1e13" Offset="0"/>
                                <GradientStop Color="#070e09" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#00ff88" BlurRadius="0"
                                              ShadowDepth="0" Opacity="0"/>
                        </Border.Effect>
                        <Grid>
                            <!-- Top shine line -->
                            <Border CornerRadius="10,10,0,0" Height="12" VerticalAlignment="Top"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#12ffffff" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="outerBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#192e1e" Offset="0"/>
                                        <GradientStop Color="#0e1e13" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="outerBorder" Property="BorderBrush" Value="#3a7a4a"/>
                            <Setter Property="Foreground" Value="#9ae0aa"/>
                            <Setter TargetName="outerBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#00ff88" BlurRadius="14"
                                                      ShadowDepth="0" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="outerBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#030805"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="outerBorder" Property="BorderBrush" Value="#00e676"/>
                            <Setter Property="Foreground" Value="#00e676"/>
                            <Setter TargetName="outerBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#00ff88" BlurRadius="6"
                                                      ShadowDepth="0" Opacity="0.9"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#1e3a22"/>
                            <Setter TargetName="outerBorder" Property="BorderBrush" Value="#0d1e12"/>
                            <Setter TargetName="outerBorder" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ═══════════════════════════════
         NEW GAME BUTTON  (arcane purple)
    ═══════════════════════════════ -->
    <Style x:Key="NewGameActionButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="Foreground" Value="#d4a8f0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" CornerRadius="10"
                            BorderBrush="#3a1a6a" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1a0d2e" Offset="0"/>
                                <GradientStop Color="#0f0820" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Border CornerRadius="10,10,0,0" Height="10" VerticalAlignment="Top"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#10ffffff" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#281040" Offset="0"/>
                                        <GradientStop Color="#180c30" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="border" Property="BorderBrush" Value="#7a3aaa"/>
                            <Setter Property="Foreground" Value="#e8c8ff"/>
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#9c27b0" BlurRadius="16"
                                                      ShadowDepth="0" Opacity="0.55"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#08040f"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#b070e0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ═══════════════════════════════
         SAVE BUTTON  (amber gold)
    ═══════════════════════════════ -->
    <Style x:Key="SaveActionButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="Foreground" Value="#e0b050"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" CornerRadius="10"
                            BorderBrush="#4a3000" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1a1000" Offset="0"/>
                                <GradientStop Color="#0e0900" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Border CornerRadius="10,10,0,0" Height="10" VerticalAlignment="Top"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#10ffffff" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#261800" Offset="0"/>
                                        <GradientStop Color="#1a1000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="border" Property="BorderBrush" Value="#9a6000"/>
                            <Setter Property="Foreground" Value="#f5cc70"/>
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#ff8f00" BlurRadius="14"
                                                      ShadowDepth="0" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#080500"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#aa8030"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ═══════════════════════════════
         GAME BUTTON  (alias kept for
         backward compatibility)
    ═══════════════════════════════ -->
    <Style x:Key="GameButton" TargetType="Button"
           BasedOn="{StaticResource DPadButton}"/>

</ResourceDictionary>
